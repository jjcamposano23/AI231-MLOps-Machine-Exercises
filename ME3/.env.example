# ---- ME3 voice agent (Iris) configuration. Copy to .env and fill in the keys. ----
# Models / providers
DEEPGRAM_API_KEY=            # ASR (nova-3) + TTS (aura-2) via our MCP servers; $200 free credit at deepgram.com
ANTHROPIC_API_KEY=           # talker LLM (claude-haiku-5-5) and background agent (claude-sonnet-5-5)
OPENROUTER_API_KEY=          # alternative LLM provider (LLM_PROVIDER=openrouter)
TAVILY_API_KEY=              # web search tool

LLM_PROVIDER=openrouter       # anthropic | openrouter
LLM_MODEL=openai/gpt-4.1-mini  # fast + good tool calls; or google/gemini-2.5-flash, anthropic/claude-haiku-5-5
AGENT_PROVIDER=openrouter
AGENT_MODEL=google/gemini-2.5-flash   # stronger: anthropic/claude-sonnet-5-5 (costs more)

ASR_PROVIDER=deepgram        # deepgram | openai_compat (ASR_BASE_URL, ASR_MODEL, ASR_API_KEY)
TTS_PROVIDER=deepgram        # deepgram | openai_compat (TTS_BASE_URL, TTS_MODEL, TTS_API_KEY)
TTS_VOICE=aura-2-pandora-en    # British, calm/crisp (Deepgram has no Irish voice)

# Audio (pick indexes with: python -m assistant.main --list-devices)
AUDIO_IN_SAMPLE_RATE=16000
AUDIO_OUT_SAMPLE_RATE=24000
INPUT_DEVICE_INDEX=
OUTPUT_DEVICE_INDEX=

# Turn taking / barge-in
TURN_STOP=smart              # smart (Smart Turn v3 model) | timeout
SPEECH_TIMEOUT=0.6           # seconds of silence when TURN_STOP=timeout
VAD_CONFIDENCE=0.7
VAD_STOP_SECS=0.2
INTERRUPT_MIN_WORDS=0        # >0 = only interrupt after N transcribed words (helps with speaker echo)

BOT_NAME=Iris
HOME_CITY=Quezon City
LOCAL_TZ=Asia/Manila
ENABLE_TOOLS=1
ENABLE_AGENT=1
MCP_AUTOSTART=1              # start the MCP servers automatically if they aren't running
LOG_LEVEL=INFO
FILLERS=1                    # short 'One sec.' while slow tools (web search, weather) run
ECHO_FILTER=1                # drop transcripts that repeat what Iris just said (speaker echo)
AEC=1                        # WebRTC acoustic echo cancellation: open speaker + mic, real full duplex
AEC_DELAY_MS=60              # speaker->mic delay hint (Bluetooth speakers: ~200)

# Web emulator (emulator/public/index.html) via Firebase Realtime Database: database URL + database SECRET
# (Pi only, never in the page). Rules + hosting: emulator/firebase.json.  Leave empty to disable.
EMULATOR_FIREBASE_URL=
EMULATOR_FIREBASE_SECRET=

# Spotify (Premium): Pi = Spotify Connect speaker "Iris" (scripts/iris-spotify.service), Web API via PKCE.
# Client ID from developer.spotify.com/dashboard (redirect URI http://127.0.0.1:8888/callback), then once:
#   ssh -L 8888:127.0.0.1:8888 -t <pi> "cd ~/ME3 && .venv/bin/python -m tools.spotify_login"
SPOTIFY_CLIENT_ID=
SPOTIFY_DEVICE=Iris
